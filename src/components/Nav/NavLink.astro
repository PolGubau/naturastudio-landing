---
import { type navLinkItem } from "@config/navData.json";

interface Props {
	navItem: navLinkItem;
	class?: string;
}

const { navItem, class: className } = Astro.props as Props;
const { text, link, newTab = false, hoverImage } = navItem;

const image = `../../../../images/${hoverImage}`;
---

<li>
	<a
		class:list={[
			`nav__link--base group relative flex w-full items-center justify-center text-neutral-200 ${className}`,
			{ "": Astro.url.pathname === link },
		]}
		href={link}
		target={newTab ? "_blank" : ""}
		rel={newTab ? "noopener noreferrer" : ""}
	>
		{text}

		<!-- hover image -->
		<div
			class="pointer-events-none absolute invert top-0 left-1/2 z-20 -translate-x-1/2 scale-125 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
		>
			<img src={image} alt="" class="h-[2em] object-contain" />
		</div>
	</a>
</li>
